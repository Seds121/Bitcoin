# Bitcoin data providers (Esplora-compatible, no key required).
# Comma-separated, tried in order. If mempool.space is blocked on your network,
# blockstream.info is used automatically. Use your own mempool instance first
# for production: MEMPOOL_API_BASE=https://your-mempool.example.com/api,https://blockstream.info/api
MEMPOOL_API_BASE=https://mempool.space/api,https://blockstream.info/api

# Price history provider (CoinGecko public API, no key required).
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
